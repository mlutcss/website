<%
	const css = {
		buttonShape:"-Sz100p D-f Jc-c Ai-c Gap2.5u P2u xxl_P2.5u Fns4u Lnh100p Lts0 Fnst-n Fnw400 Bdrd8 Ts-$shortTs Bd1;s;$brand",
	}

	if (it.variant === 'brand') {
				css.buttonColors = "Bgc-$brand Bgc-$brand500_h Bgc-$brand200_a";
				css.textColor = "C#fff";
	} else {
		css.buttonColors = "Bgc-$white100 Bgc-$white200_h Bgc-$white300_a";
				css.textColor = "C#22141A";
	}

	const isLink = it.url && it.url !== '#0';
	const tag = isLink ? 'a' : 'button';
	const className = it.className || '';
	const iconClass = it.iconClass || 'W24 H24';
%>

<<%= tag %>
	class="btn <%= css.buttonShape %> <%= css.buttonColors %> <%= css.textColor %> <%= className %>"
	<%= isLink ? `href=${it.url}` : '' %>
	<%= tag === 'button' ? 'type="button"' : '' %>
>
	<span class="button-text"><%= it.text %></span>
	<% if (it.icon) { %>
		<svg class="button-icon <%= iconClass %>" width="24" height="24">
			<use href="/assets/img/icons.svg#<%= it.icon %>"></use>
		</svg>
	<% } %>
</<%= tag %>>
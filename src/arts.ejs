				<art-panel class="D Ps Bdrd2u Ov-h -Ctx Gr-s2 -Ts md_Tf md_-S102p_h" id="<%= art.artId %>" size="<%= art.size %>" style="<%= getMasonryStyle(art.artId) %> background-color: var(--ml-art<%= toPascalCase(art.artId) %>)">
					<div class="art -Sz100p Ov-h Plcc-c Plci-c">
						<%- include(`./arts/${art.artId}.ejs`) %>
					</div>
					<div class="links Ps-a B0 L0 W100p H15u Zi15 P4u M0 D-f Fld-c Jc-fe O0 Pne ^:h_Pne-a ^:h_O1 Bgc-$gray250 Bcf -Blr15 -Ts">
						<div class="Mt-a D-f Jc-sb Ai-c">
							<a
								class="sandbox-button Txd-n M0 P1u;0.5u Bdb1;s;$white100 Bdbc-$brand500_h Bdbc- Fns4u Fnst-n Fnw400 Lnh-n <%= artsPageCSS.color %>"
								href="http://play.mlut.style/?art=<%= art.artId %>"
							>
								Open in sandbox
							</a>
							<button class="btn D-f <%= artsPageCSS.color %> link-button">

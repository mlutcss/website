<%
    const css = {
        bead: 'Ps-a Apcr4/3 -Bdy2 -Bdys-s -Bdyc-$cakeBlack Bdrd50p Tf -Tr-50p;-50p Bgc-$cakeWhite Bxsd-i;0;0;2u;2;$cakeRed',
        creamW: 'Ps-a -Sz100p Bdrd50p Bgc-$cakeWhite',
        creamY: 'Ps-a Apcr2/1 Bdrd50p Bgc-$cakeYellow Ov-h'
    };

    const leftBeads = [
        { top: -10, left: 1, width: 6 },
        { top: 0, left: 3, width: 8 },
        { top: 16, left: 7, width: 10 },
        { top: 28, left: 13, width: 12 },
        { top: 38, left: 22, width: 15 },
        { top: 45, left: 34, width: 18 }
    ];
%>

<div class="-Sz100p Ctnt-s D-f Jc-c Ai-c -CakeGreen#97de9e -CakeWhite#fff -CakeBlack#000 -CakeYellow#ece74f -CakeRed#fc0522">
    <div class="@c:apcr>=1_H90p @c:apcr<=1_W90p Apcr1 Ps-r">
        <!-- Body -->
        <div class="Ps-a B20p L0 W100p H50p Bd1u;s;$cakeBlack Bdb-tp Bgc-$cakeGreen">
            <!-- Left Eye -->
            <div class="Ps-a T30p L15p W22p Apcr1 Bdl1.5u;s;$cakeBlack Bdb1.5u;s;$cakeBlack Bdrd50p Tf -Rt-25d">
                <div class="Ps-a B3p R1p W80p Apcr1 Bdr1.5u;s;$cakeBlack Bdt1.5u;s;$cakeBlack Bdrd50p">
                    <div class="Ps-a T3p L2p W70p Apcr1 Bdl1.5u;s;$cakeBlack Bdb1.5u;s;$cakeBlack Bdrd50p">
                        <div class="Ps-a B3p R1p W60p Apcr1 Bgc-$cakeBlack Bdrd50p"></div>
                    </div>
                </div>
            </div>
            <!-- Right Eye -->
            <div class="Ps-a T30p L63p W22p Apcr1 Bdr1.5u;s;$cakeBlack Bdb1.5u;s;$cakeBlack Bdrd50p Tf -Rt25d">
                <div class="Ps-a B3p L1p W80p Apcr1 Bdl1.5u;s;$cakeBlack Bdt1.5u;s;$cakeBlack Bdrd50p">
                    <div class="Ps-a T3p R2p W70p Apcr1 Bdr1.5u;s;$cakeBlack Bdb1.5u;s;$cakeBlack Bdrd50p">
                        <div class="Ps-a B3p L1p W60p Apcr1 Bgc-$cakeBlack Bdrd50p"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Bottom Cake -->
        <div class="Ps-a B10p L0 W100p H20p Bdrd50p Bgc-$cakeGreen">
            <!-- Beads -->
            <div class="Ps-a T50p L0 -Sz100p">
                <% leftBeads.forEach((bead) => { %>
                    <!-- Left Beads -->
                    <div class="<%= css.bead %> T<%= bead.top %>p L<%= bead.left %>p W<%= bead.width %>p"></div>
                    <!-- Right Beads -->
                     <div class="<%= css.bead %> T<%= bead.top %>p L<%= 100 - bead.left %>p W<%= bead.width %>p"></div>
                <% }); %>
                <!-- Center Bead -->
                <div class="<%= css.bead %> T50p L50p W20p"></div>
                <!-- Mouth -->
                <div class="Ps-a T-50p L50p W40p H50p Tf -Trx-60p Bgc-$cakeBlack Bdrd50p">
                    <div class="Ps-a T-8p L42p -Sz100p Tf -Trx-50p Bgc-$cakeGreen Bdrd50p"></div>
                </div>
            </div>
        </div>
        <!-- Top Cake -->
        <div class="Ps-a B60p L0 W100p H20p Bd2;s;$cakeBlack Bdrd50p Bgc-$cakeWhite">
            <!-- Beads -->
            <div class="Ps-a T50p L0 -Sz100p">
                <% leftBeads.forEach((bead) => { %>
                    <!-- Left Beads -->
                    <div class="<%= css.bead %> T<%= bead.top %>p L<%= bead.left %>p W<%= bead.width %>p"></div>
                    <!-- Right Beads -->
                     <div class="<%= css.bead %> T<%= bead.top %>p L<%= 100 - bead.left %>p W<%= bead.width %>p"></div>
                <% }); %>
                <!-- Center Bead -->
                <div class="<%= css.bead %> T50p L50p W20p"></div>
            </div>
        </div>
        <!-- Cream -->
        <div class="Ps-a T12p L0 W100p H20p">
            <div class="<%= css.creamY %> T-20p L55p W30p">
                <div class="<%= css.creamW %> B-5p R10p"></div>
            </div>
            <div class="<%= css.creamY %> T-20p L15p W30p">
                <div class="<%= css.creamW %> B-5p L10p"></div>
            </div>
            <div class="Ps-a T-45p L35p W30p Apcr1 Bdrd50p Bgc-$cakeYellow Ov-h">
                <div class="Ps-a T5p L-5p W110p Apcr1 Bdrd50p Bgc-$cakeWhite">
                    <!-- Cherry -->
                    <div class="Ps-a T32p L35p W30p Apcr3/2 Bd2;s;$cakeBlack Bdt-tp Bdrd40p/55p;55p;85p;85p -Gdrd-cr;at;70p;30p,$cakeWhite;0;10p,$cakeRed;30p;100p Tf -Rt-10d">
                        <div class="Ps-a T-180p L30p W60p H180p Bdl1u;s;$cakeBlack Bdrd50p"></div>
                    </div>
                </div>
            </div>
            <div class="<%= css.creamY %> T15p L72p W30p">
                <div class="<%= css.creamW %> T-5p L-10p"></div>
            </div>
            <div class="<%= css.creamY %> T35p L60p W30p">
                <div class="<%= css.creamW %> T-10p L-10p"></div>
            </div>
            <div class="<%= css.creamY %> T15p L-2p W30p">
                <div class="<%= css.creamW %> T-5p R-10p"></div>
            </div>
            <div class="<%= css.creamY %> T35p L10p W30p">
                <div class="<%= css.creamW %> T-10p R-10p"></div>
            </div>
            <div class="<%= css.creamY %> T45p L35p W30p">
                <div class="<%= css.creamW %> T-10p L0p"></div>
            </div>
            <div class="<%= css.creamY %> T5p L20p W25p">
                <div class="<%= css.creamW %> T-10p L5p"></div>
            </div>
            <div class="<%= css.creamY %> T5p L55p W25p">
                <div class="<%= css.creamW %> T-10p R5p"></div>
            </div>
        </div>
    </div>
</div>

<%# Comparison %>

<section id="comparison" class="Ps D-f Fld-c Ai-c P5u;4u;10u Bgc-$core800 xl_P20u;20u;30u">
	<div class="xl_D-n <%= decorCss.squareDot %>"></div>

	<h2 class="M3u;0;0 Fnf-SN;Pro Fns6u Fnw700 Fnst-n Lnh100p Lts0 Txt C-$brand Txa-c">Why choose mlut?</h2>

	<%# Strong naming %>
	<h3 class="M9u;0;0 Fns4u Fnw600 Fnst-n Lnh100p Lts0 C-$accent900 Txa-c Ps Zi1">Strong naming</h3>
	<ul class="Lss-n D-f Fld-c Ai-c Gap16 M4.5u;0;0 P4u;3u W100p Bdrd8 Bgc-$core810 -Gdl90d,$brand50;0p,$brand100;100p md_Fld-r md_Ai-str xl_P24 xl_Gap32 xl_M26;0;0 Ps Zi1">

		<%# Tailwind card %>
		<li class="P4u;3u W100p Bdrd8 Bgc-$core830 xl_P3u">
			<h4 class="M0 Txa-c Fns4u Fnw600 Fnst-n Lnh100p Lts0 C-$tertiary800">Tailwind CSS</h4>
			<ul class="M3u;0;0 D-f Fld-c Gap12 Lsst-n P0 Fnf-mUm Fns3u Fnst-n Fnw400 Lnh150p Lts0 C-$tertiary760">
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">justify-*</span>: content, items or self?
				</li>
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">flex</span> => <span class="C#FF1010">display: flex</span>, <span class="C#FF1010">but flex-auto</span> => <span class="C#FF1010">flex:1 1 auto</span>
				</li>
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">bg-none</span> => reset all backgrounds? Nope, only <span class="C#FF1010">background-image</span>
				</li>
			</ul>
		</li>

		<%# Tachyons card %>
		<li class="P4u;3u W100p Bdrd8 Bgc-$core830 xl_P3u">
			<h4 class="M0 Txa-c Fns4u Fnw600 Fnst-n Lnh100p Lts0 C-$tertiary800">Tachyons</h4>
			<ul class="M3u;0;0 D-f Fld-c Gap12 Lsst-n P0 Fnf-mUm Fns3u Fnst-n Fnw400 Lnh150p Lts0 C-$tertiary760">
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">br-0</span> => <span class="C#FF1010">border-right-width: 0</span>,but <span class="C#FF1010">br1</span> => <span class="C#FF1010">border-radius: .125rem</span>
				</li>
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">normal</span>: line-height, font-weight or letter-spacing?
				</li>
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$tertiary800_b">
					<span class="C#FF1010">b</span> => bottom, border, or <span class="C#FF1010">display: block</span>? No, it is <span class="C#FF1010">font-weight: bold</span>
				</li>
			</ul>
		</li>

		<%# mlut card %>
		<li class="P4u;3u W100p Bd1;s;$brand Bdrd8 Bgc-$core830 xl_P3u">

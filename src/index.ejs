				</li>
				<li class="D Ps Pl20 <%= comparisonCss.marker %> Bgc-$brand_b">
					<span class="C#68AD00">Bdr</span> => <span class="C#68AD00">border-right: 1px solid</span> and <span class="C#68AD00">Bdrd1</span> => <span class="C#68AD00">border-radius: 1px</span>
				</li>
			</ul>
		</li>

		<div class="xl_D-n <%= decorCss.squareFrame %>"></div>
	</ul>

	<%# Shorter class names and convenient syntax %>
